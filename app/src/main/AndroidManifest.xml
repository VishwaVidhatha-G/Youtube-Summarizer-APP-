<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet Access Required to Fetch Transcripts and Call Gemini API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YouTubeSummarizer">

        <!-- Main Workspace Application: Manage settings and view history list -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.YouTubeSummarizer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Frictionless Bottom Overlay: Triggered when sharing from YouTube or YouTube Vanced -->
        <activity
            android:name=".presentation.overlay.OverlayActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.YouTubeSummarizer.Overlay"
            android:windowSoftInputMode="adjustResize">
            
            <!-- Intercept text share requests -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>

</manifest>
